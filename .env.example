# Telegram bot token from @BotFather — the only value you must set.
TELEGRAM_BOT_TOKEN=
# Optional: lock the bot to one chat. Leave blank and the first chat to /start owns it.
TELEGRAM_CHAT_ID=

# Single-account mode. With wallets.json present this is ignored.
WALLET_PRIVATE_KEY=
# Leave blank to let the bot pick a human-looking name derived from the wallet.
KINDRA_NAME=

# valley (EU) or us
KINDRA_WORLD=valley
# Start farming as soon as the service comes up, instead of waiting for the panel.
KINDRA_AUTOSTART=1

RH_RPC=https://rpc.mainnet.chain.robinhood.com

# THE GOLD RESERVE. Every character keeps this much in-game gold; everything above it is listed for
# real $KINDRA, 1,000 gold at a time (the book's own minimum lot). One number, the whole fleet —
# characters minted later pick it up with no migration. At 300 the character lists as soon as it
# holds 1,300 and keeps almost nothing; raise it if you want it to hold a meal-and-upgrade budget.
KINDRA_GOLD_RESERVE=300
KINDRA_CASHOUT_LOT=1000
KINDRA_PULSE_MIN=25
