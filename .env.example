# Telegram bot token from @BotFather — the only value you must set.
TELEGRAM_BOT_TOKEN=
# Optional: lock the bot to one chat. Leave blank and the first chat to /start owns it.
TELEGRAM_CHAT_ID=

# Single-account mode. With wallets.json present this is ignored.
WALLET_PRIVATE_KEY=
# Leave blank to let the bot pick a human-looking name derived from the wallet.
KINDRA_NAME=

# valley (EU) or us
KINDRA_WORLD=valley
# Start farming as soon as the service comes up, instead of waiting for the panel.
KINDRA_AUTOSTART=1

RH_RPC=https://rpc.mainnet.chain.robinhood.com
